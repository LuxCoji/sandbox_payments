# Anything the image does not need, or must not carry.
.env
.git
.github
node_modules
frontend/node_modules
frontend/dist
runs
data
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
docs
tests
**/tests
# scripts/ is needed - download_data.py runs during the build - so it is not
# listed here. data/ is excluded because the CSVs are gitignored and the image
# generates its own; copying an empty directory over them would undo that.
*.md
uv.lock
