# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real keys. Shell `export VAR=...` syntax, matching the existing .env.

# ── Core simulation (required for anything that touches ChronoDAG) ─────────
# Postgres connection string (Supabase in practice — see CLAUDE.md, no local
# docker-compose stack). Get this from your Supabase project's connection
# settings, or any Postgres instance you control.
export FINSIM_DB_URL=postgresql://user:password@host:5432/dbname

# ── Observability (optional) ────────────────────────────────────────────
# Grafana Cloud OTLP endpoint/headers. Leave unset to skip tracing export.
export OTEL_EXPORTER_OTLP_ENDPOINT=
export OTEL_EXPORTER_OTLP_HEADERS=

# ── Red-team harness LLM providers (required for `make redteam`) ───────────
# One key per deployment entry in agents/redteam/providers.yaml. The
# variable names below (GROQ_API_KEY_1, etc.) must match each entry's
# api_key_env exactly — if you add more deployments to providers.yaml (e.g.
# GROQ_API_KEY_2 from a second account), add the matching var here too.
#
# Where to get each one:
#
#   Groq        -> console.groq.com -> sign up -> console.groq.com/keys
#                  Free tier: 30 RPM, org-level (not per-key) limit.
#   OpenRouter  -> openrouter.ai -> sign up -> openrouter.ai/keys
#                  Free tier: 20 RPM, 50 RPD unfunded / 1,000 RPD after a
#                  one-time $10 credit purchase. Account-level, not per-key.
#   Gemini      -> aistudio.google.com -> sign up -> "Get API key"
#                  Free tier limits are per-project and NOT fixed constants —
#                  check your actual limits at aistudio.google.com/rate-limit
#                  and keep agents/redteam/providers.yaml's `rpm` value in
#                  sync with what you see there.
#   NVIDIA Build -> build.nvidia.com -> join the NVIDIA Developer Program ->
#                  generate a key from a model's API page.
#                  No official rate-limit number is published; ~40 RPM is
#                  community-reported, treat as soft/unreliable.
#
# CAUTION: Groq and OpenRouter rate-limit at the account/org level, not per
# key — a second key on the SAME account does not add quota. Only a
# genuinely separate account does. Using multiple accounts to multiply a
# single free tier's quota sits in a ToS gray area for both — see the
# caution comment at the top of agents/redteam/providers.yaml before adding
# more accounts.

export GROQ_API_KEY_1=
export OPENROUTER_API_KEY_1=
export GEMINI_API_KEY_PROJECT_1=
export NVIDIA_API_KEY_1=
