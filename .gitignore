# Red-team harness — local persona identity bookkeeping (not simulation state)
agents/redteam/.persona_identity.json

# Collected simulator traffic. Generated, large, and reproducible from a seed.
runs/

# Trained models, except the shipped ones. A checkpoint is generated output and
# does not belong in git as a rule - but a branch that cannot be cloned and run
# is worth less than the rule is worth keeping.
#
# Both rails ship a model, and both exceptions have to be listed. Adding
# wire_xgboost.json without its `!` line silently left the wire model out of
# every clone while the code that loads it went in, which reads as "the model
# is optional" rather than "the model is missing".
models/*
!models/card.pt
!models/wire_xgboost.json
!models/wire_feature_names.json
